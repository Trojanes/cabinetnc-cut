<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CabinetNC.Compute.Contracts\CabinetNC.Compute.Contracts.csproj" />
    <ProjectReference Include="..\CabinetNC.Domain\CabinetNC.Domain.csproj" />
    <ProjectReference Include="..\CabinetNC.FusionPackage\CabinetNC.FusionPackage.csproj" />
    <ProjectReference Include="..\CabinetNC.Application\CabinetNC.Application.csproj" />
    <ProjectReference Include="..\CabinetNC.ComputeWorker\CabinetNC.ComputeWorker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CabinetNC.Infrastructure\CabinetNC.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="3.119.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Copy ComputeWorker next to Desktop so WorkerProcessHost can spawn it. -->
  <Target Name="CopyWorker" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_WorkerOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\CabinetNC.ComputeWorker\bin\$(Configuration)\net10.0\'))</_WorkerOut>
      <_CopyDest Condition="'$(PublishDir)' != ''">$(PublishDir)</_CopyDest>
      <_CopyDest Condition="'$(PublishDir)' == ''">$(OutputPath)</_CopyDest>
    </PropertyGroup>
    <ItemGroup>
      <_WorkerFiles Include="$(_WorkerOut)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_WorkerFiles)" DestinationFiles="@(_WorkerFiles->'$(_CopyDest)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="Exists('$(_WorkerOut)CabinetNC.ComputeWorker.exe')" />
  </Target>

  <!-- One user-facing build: desktop shortcut launches dist\CabinetNC-Cut. -->
  <Target Name="CopyToDesktopLaunch" AfterTargets="CopyWorker"
          Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <_DesktopLaunch>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\dist\CabinetNC-Cut\'))</_DesktopLaunch>
    </PropertyGroup>
    <ItemGroup>
      <_LaunchFiles Include="$(OutputPath)**\*.*" Exclude="$(OutputPath)publish\**\*.*" />
    </ItemGroup>
    <MakeDir Directories="$(_DesktopLaunch)" />
    <Copy SourceFiles="@(_LaunchFiles)"
          DestinationFiles="@(_LaunchFiles->'$(_DesktopLaunch)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Retries="3"
          RetryDelayMilliseconds="400" />
    <Message Importance="high" Text="Updated desktop launch folder: $(_DesktopLaunch)" />
  </Target>

</Project>
